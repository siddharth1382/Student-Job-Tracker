    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.code === 200 || pm.response.code === 201) {",
          "    // If this is a login or register request, save the token",
          "    if (pm.response.json().token) {",
          "        pm.environment.set(\"authToken\", pm.response.json().token);",
          "    }",
          "    ",
          "    // If this is a job creation, save the job ID",
          "    if (pm.response.json()._id && pm.request.url.path.includes('/jobs') && pm.request.method === 'POST') {",
          "        pm.environment.set(\"jobId\", pm.response.json()._id);",
          "    }",
          "}"
        ]
      }
    }
